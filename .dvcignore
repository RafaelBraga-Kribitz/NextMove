# Transient staging root (paths.py: resolve_staging_path / staging_root). Part files and
# DuckDB spill files live here for the duration of a single run and are removed by
# clear_staging() before the run exits -- never a tracked artifact.
data/_staging/

.venv/
__pycache__/
tests/

